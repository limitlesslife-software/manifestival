<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        allowBackup="false" JA usesCleartextTraffic="false".

        VARMUUSKOPIO: Supabase-client on persistSession: true, joten
        kirjautumisistunto - access token ja pitkaikainen refresh token -
        elaa WebView'n localStoragessa. Se sijaitsee sovelluksen
        datahakemistossa, jonka Androidin automaattinen varmuuskopio veisi
        kayttajan Google Driveen. Pitkaikaista tunnusta ei kuuluu
        varmuuskopioon. Sama koskee tulevaa hyvinvointi- ja talousdataa.

        Hinta on pieni: kayttajan oma data on Supabasessa, joten laitteen
        vaihdossa menetetaan vain istunto ja laitekohtaiset asetukset
        (viimeksi avattu nakyma). Kayttaja kirjautuu uudelleen.

        SELVAKIELINEN LIIKENNE: targetSdk 36:n oletus on jo false, mutta
        oletukseen ei nojata. Nimenomainen arvo sailyy, vaikka
        targetSdk joskus laskisi.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            HERATYKSET JA PUHUTUT MUISTUTUKSET (AlarmPlugin.java, JS:
            src/platform/alarms.js). Kaikki komponentit ovat suljettuja
            (exported="false"): muut sovellukset eivat voi laukaista,
            sammuttaa eika torkuttaa heratysta. Jarjestelma toimittaa silti
            suojatut lahetykset (kaynnistys, kellon ja vyohykkeen vaihto).

            SUORA KAYNNISTYS (directBootAware="true"): puhelin voi kaynnistya
            yolla uudelleen (automaattinen uudelleenkaynnistys, kaatuminen,
            akku) ja jaada lukituksen taakse. Ennen ensimmaista avausta vain
            nama nelja komponenttia toimivat: BootReceiver palauttaa
            heratykset LOCKED_BOOT_COMPLETEDista, AlarmReceiver ja
            AlarmService soittavat, AlarmActivity nakyy lukitulla naytolla.
            Niiden tila on laitesuojatussa tallennuksessa ilman
            henkilokohtaisia teksteja (AlarmStore.java). Muu sovellus
            (MainActivity, WebView) ei ole directBootAware. Uutta lupaa ei
            tarvita: LOCKED_BOOT_COMPLETED kuuluu samaan kaynnistyslupaan.
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <!-- Vain uudelleenajastus: ei koskaan kaynnista palvelua (Android 15). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Soiva heratys ja puhe: etualapalvelu, tyyppi mediaPlayback (vain toisto, ei mikrofonia). -->
        <service
            android:name=".AlarmService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Pieni natiivi heratysnakyma lukitulle naytolle: ei WebViewta. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:directBootAware="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        MIKROFONI: vain puheentunnistukseen (SpeechPlugin.java). Lupaa
        kysytaan vasta kun kayttaja napauttaa mikrofonia, ei koskaan
        kaynnistyksessa. Aanta ei tallenneta, eika taustakuuntelua ole:
        kuuntelu perutaan, kun sovellus siirtyy taustalle.

        Aaniasetusten muokkauslupaa EI julisteta tarkoituksella. Ilman sita
        Capacitor hylkaa WebView'n omat mikrofonipyynnot, joten web-koodi ei
        voi avata mikrofonia liitannaisen ohi. Testit (android.test)
        vartioivat tata.

        MIKROFONI EI OLE PAKOLLINEN LAITTEISTO. Mikrofonilupa synnyttaa
        Play-kaupassa implisiittisen pakollisen android.hardware.microphone-
        ominaisuuden, joka suodattaisi pois laitteet ilman mikrofonia. Puhe
        on oikotie, ei edellytys: kirjoittaminen toimii aina. Siksi
        ominaisuus julistetaan nimenomaisesti required="false".
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
        HERATYKSET (AlarmPlugin.java). Muistutusliitannainen yhdistaa osan
        naista jo nyt; ne julistetaan tassa itse, koska heratys tarvitsee
        ne omana ominaisuutenaan.

        - Kaynnistyksen jalkeinen palautus: vain uudelleenajastus.
        - Tarkat heratykset: kayttaja antaa oikeuden Asetuksista (Android
          14+ ei anna sita oletuksena). Sovellus avaa asetuksen vain
          kayttajan napautuksesta. Automaattisesti myonnettavaa
          heratyskellon lupaa EI julisteta: se on varattu sovelluksille,
          joiden paatehtava on heratyskello (Play-kaupan ehto).
        - Koko nayton ilmoitus: Android 14+ myontaa sen vain heratys- ja
          puhelusovelluksille; ilman sita heratys nakyy nousevana
          ilmoituksena (canUseFullScreenIntent).
        - Etualapalvelu vain tyyppia mediaPlayback: aanen ja puheen toisto.
          Mikrofonin, sijainnin tai muun tyyppista etualapalvelua ei ole.
        - Heratyslukko: rajattu (aikaraja) ja vapautetaan aina.
        Varinaa ei kayteta, joten sen lupaa ei julisteta.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        SIJAINTI: lupaa ei julisteta, koska mikaan toteutettu ominaisuus ei
        kayta sijaintia (src/platform/capabilities.js NATIVE_LOCATION_ENABLED
        = false). Jos sijainti joskus palaa (reittipalvelu, WP11), vain
        likimaarainen etualan lupa lisataan, ja sen rinnalle
        android.hardware.location required="false", jottei jakelu rajaudu.
    -->

    <!--
        Android 11+ nayttaa sovellukselle vain julistetut palvelut: ilman tata
        jarjestelman puheentunnistuspalvelu ei nay SpeechRecognizerille.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Puhesynteesi (TextToSpeech): Android 11+ ei muuten nayta puhemoottoria. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- "Avaa reitti" -painike tarkistaa, onko Google Maps asennettu (muuten https-linkki). -->
        <package android:name="com.google.android.apps.maps" />
    </queries>
</manifest>
