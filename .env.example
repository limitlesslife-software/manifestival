# Manifestival — ymparistomuuttujat
#
# Kopioi tama tiedosto nimelle .env paikallista kehitysta varten.
# ALA KOSKAAN commitoi .env-tiedostoa. Vain muuttujien NIMET kuuluvat tanne.
#
# Tuotannossa nama asetetaan Vercelin projektiasetuksissa
# (Settings -> Environment Variables), ei tiedostossa.

# --- Palvelinpuoli (server-side only) ---
# Anthropic API -avain. Kayttaa VAIN api/parse.js palvelimella.
# EI saa koskaan paatya selaimeen, index.html:aan eika Git-historiaan.
ANTHROPIC_API_KEY=

# --- Selainpuoli (public, turvallista naytt) ---
# Supabase-projektin URL ja anon-avain ovat julkisia arvoja.
# Ne EIVAT yksinaan ole tietoturvariski — tietoturva perustuu RLS-politiikkoihin.
# Nykyisessa toteutuksessa nama ovat kovakoodattuna index.html:ssa.
SUPABASE_URL=
SUPABASE_ANON_KEY=
